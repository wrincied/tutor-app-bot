# Copy to .env and fill real values:
#   copy .env.example .env
#
# 1) TELEGRAM_BOT_TOKEN — from @BotFather (/newbot)
# 2) BOT_API_SECRET — shared with backend/.env (X-Bot-Secret header)
# 3) BOT_USERNAME — bot username without @
# 4) BACKEND_URL — Express API for telegram-linked callback

TELEGRAM_BOT_TOKEN=your_botfather_token
BOT_API_SECRET=change-me-long-random
BOT_HTTP_HOST=0.0.0.0
BOT_HTTP_PORT=8081
BOT_USERNAME=simp1e4ubot
BOT_DB_PATH=data/bot.sqlite3
BACKEND_URL=http://127.0.0.1:3001
