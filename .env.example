# Copy to .env and fill real values:
#   copy .env.example .env
#
# Local dev (polling + SQLite):
#   TELEGRAM_BOT_TOKEN, BOT_API_SECRET, BACKEND_URL
#
# Cloud Run (webhook + Firestore) — see deploy/DEPLOY.md

TELEGRAM_BOT_TOKEN=your_botfather_token
BOT_API_SECRET=change-me-long-random
BOT_HTTP_HOST=0.0.0.0
BOT_HTTP_PORT=8081
BOT_USERNAME=simp1e4ubot
BOT_DB_PATH=data/bot.sqlite3
PUBLIC_SITE_URL=https://simple4u.at
BACKEND_URL=http://127.0.0.1:3001

# polling | webhook
BOT_MODE=polling
# sqlite | firestore
BINDING_STORE=sqlite
GCP_PROJECT=

# Required when BOT_MODE=webhook (Cloud Run URL without trailing slash)
WEBHOOK_BASE_URL=
WEBHOOK_PATH=/telegram/webhook
WEBHOOK_SECRET=change-me-webhook-secret
